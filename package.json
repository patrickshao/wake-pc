{
  "name": "wake-pc",
  "version": "1.0.0",
  "description": "Wake and sleep a Windows PC from Decky, a Mac, or an agent.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "preview": "node scripts/preview.mjs",
    "preview:check": "tsc -p preview/tsconfig.json && node scripts/preview.mjs --build",
    "test": "node scripts/run.mjs test",
    "test:python": "node scripts/run.mjs test:python",
    "test:frontend": "node scripts/run.mjs test:frontend",
    "package": "node scripts/run.mjs package",
    "package:release": "node scripts/run.mjs package --with-companion",
    "serve": "node scripts/run.mjs serve",
    "security:verify": "node scripts/run.mjs verify"
  },
  "keywords": [
    "decky",
    "steamos",
    "wake-on-lan",
    "sleep"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.6",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.62.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@decky/api": "1.1.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <3": "2.1.7"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
